# fe-admin — .env.example (plan §1.4, validated at server start by src/server/env.ts).
# Copy to .env: cp fe-admin/.env.example fe-admin/.env   (Windows: copy fe-admin\.env.example fe-admin\.env)
# Secrets are intentionally empty: fill them locally (>= 32 chars, e.g. `openssl rand -base64 32`).
# All variables are server-only (BFF) and never reach the client bundle (`pnpm check:bundle`).
# There are no client (VITE_*) variables yet.

OIDC_ISSUER=http://localhost:4000
OIDC_CLIENT_ID=fe-admin
OIDC_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_API_BASE_URL=http://localhost:4000
ADMIN_API_RESOURCE=http://localhost:4000/admin/
APP_URL=http://localhost:3000
