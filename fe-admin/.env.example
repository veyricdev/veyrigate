# fe-admin — .env.example (plan §1.4). Placeholder only, KHÔNG commit secret thật.
# Copy sang .env: cp fe-admin/.env.example fe-admin/.env   (Windows: copy fe-admin\.env.example fe-admin\.env)

# --- Server-only (BFF): KHÔNG đưa vào client bundle ---
OIDC_ISSUER=http://localhost:4000
OIDC_CLIENT_ID=fe-admin
OIDC_CLIENT_SECRET=your-confidential-client-secret
SESSION_SECRET=replace-with-random-32-bytes
ADMIN_API_BASE_URL=http://localhost:4000
ADMIN_API_RESOURCE=http://localhost:4000/admin/
APP_URL=http://localhost:3000

# --- Client (VITE_*): an toàn để lộ ra bundle trình duyệt ---
VITE_APP_NAME=SSO Admin
