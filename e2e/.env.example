# e2e — .env.example (X1). NON-SECRET placeholders only; do NOT commit real secrets.
# The dev-user credential is read from process env by Playwright. Copy to e2e/.env (git-ignored)
# and set a real DEV_SEED_PASSWORD matching the one used by `pnpm -C be db:seed-dev`.
#   cp e2e/.env.example e2e/.env
#
# All other BE/FE env is injected by playwright.config.ts (config/env.ts) — not from here.

DEV_SEED_EMAIL=dev@example.com
DEV_SEED_PASSWORD=
# Set to 1 to reuse already-running BE/FE servers instead of letting Playwright start them.
# E2E_REUSE=1
