<h1><%= it.title %></h1><% if (it.error) { %><p role="alert"><%= it.error %></p><% } %><p>Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p><form method="post" action="/login/mfa"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label>Code<input name="code" type="text" inputmode="text" autocomplete="one-time-code" maxlength="32" required autofocus></label><button type="submit">Verify</button></form><p><a href="/login">Start again</a></p>