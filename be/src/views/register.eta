<h1><%= it.title %></h1><p>Use an email address you can verify.</p><form method="post" action="/register"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Password<input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label><button type="submit">Create account</button></form><p><a href="/login">Already registered?</a></p>