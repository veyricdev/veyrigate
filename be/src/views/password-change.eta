<h1><%= it.title %></h1><% if (it.error) { %><p role="alert"><%= it.error %></p><% } %><form method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label>Current password<input name="current_password" type="password" maxlength="128" autocomplete="current-password" required></label><label>New password<input name="new_password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label><button type="submit">Change password</button></form><p>Every session, including this one, is signed out after the change.</p><p><a href="/">Cancel</a></p>