<h1><%= it.title %></h1><p><%= it.message %></p><% if (it.secondaryUrl) { %><p><a href="<%= it.secondaryUrl %>"><%= it.secondaryLabel %></a></p><% } %><% (it.links ?? []).forEach(function (l) { %><p><a href="<%= l.url %>"><%= l.label %></a></p><% }) %><p><a href="<%= it.actionUrl ?? '/login' %>"><%= it.actionLabel ?? 'Return to sign in' %></a></p>