<h1><%= it.title %></h1><p>Continue to choose a new password.</p><form method="post" action="/reset/code"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label id="token-manual">Code from the email<input id="token" name="token" value="" required autocomplete="one-time-code" spellcheck="false"></label><button type="submit">Continue</button><script src="/assets/token-fragment.js"></script></form>