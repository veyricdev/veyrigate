<h1><%= it.title %></h1><p>An account already exists for <strong><%= it.email %></strong>. Enter its password to link <%= it.provider %> to it.</p><form method="post" action="/auth/link"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label>Password<input name="password" type="password" minlength="8" maxlength="128" autocomplete="current-password" required></label><button type="submit">Link and sign in</button></form><p><a href="<%= it.loginUrl %>">Use another sign-in method</a></p>
