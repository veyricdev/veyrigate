<h1><%= it.title %></h1><p>Signing you out of connected applications…</p><div class="frontchannel" hidden><% it.iframes.forEach(function(src){ %><iframe src="<%= src %>" title="logout" referrerpolicy="no-referrer"></iframe><% }) %></div><a id="logout-continue" data-target="<%= it.target %>" href="<%= it.target %>">Continue</a><noscript><p>Continue to <a href="<%= it.target %>">finish signing out</a>.</p></noscript><script src="/assets/logout-redirect.js"></script>
