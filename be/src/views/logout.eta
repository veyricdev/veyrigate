<h1><%= it.title %></h1><p>Sign out of this browser, or everywhere you are signed in.</p><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><% if (it.idTokenHint) { %><input type="hidden" name="id_token_hint" value="<%= it.idTokenHint %>"><% } %><% if (it.postLogoutRedirectUri) { %><input type="hidden" name="post_logout_redirect_uri" value="<%= it.postLogoutRedirectUri %>"><% } %><% if (it.state) { %><input type="hidden" name="state" value="<%= it.state %>"><% } %><% if (it.clientId) { %><input type="hidden" name="client_id" value="<%= it.clientId %>"><% } %><button type="submit">Sign out</button> <button type="submit" formaction="/logout?scope=all">Sign out everywhere</button></form>