<h1><%= it.title %></h1><p>Choose a password between 8 and 128 characters.</p><form method="post" action="/reset"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label id="token-manual">Code from the email<input id="token" name="token" value="" required autocomplete="one-time-code" spellcheck="false"></label><label>New password<input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label><button type="submit">Change password</button><script src="/assets/token-fragment.js"></script></form>