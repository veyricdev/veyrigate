<h1><%= it.title %></h1><p>Choose a password between 8 and 128 characters.</p><form method="post" action="/reset"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="token" value="<%= it.token %>"><label>New password<input name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required></label><button type="submit">Change password</button></form>