<h1><%= it.title %></h1><p>Confirm this email verification request.</p><form method="post" action="/verify-email"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><label id="token-manual">Code from the email<input id="token" name="token" value="" required autocomplete="one-time-code" spellcheck="false"></label><button type="submit">Verify email</button><script src="/assets/token-fragment.js"></script></form>