# be — .env.example (plan §1.4). Placeholder only, KHÔNG commit secret thật.
# Copy sang .env: cp be/.env.example be/.env   (Windows: copy be\.env.example be\.env)

# BẮT BUỘC (DEBT-098): development | test | production. Không có mặc định — thiếu ⇒ app không khởi động.
NODE_ENV=development
PORT=4000
ISSUER=http://localhost:4000

MONGO_URI=mongodb://localhost:27017/sso-idp
REDIS_URL=redis://localhost:6379
# Per-command Redis timeout (ms) — fail-fast bound so request-path commands do not hang when Redis
# is down/reconnecting (DEBT-005). Default 1000, max 10000. Keep below the /ready ping timeout.
REDIS_COMMAND_TIMEOUT_MS=1000

# Token / session TTL (giây hoặc dạng thời lượng, chốt ở B1.2)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Session (Q6 chốt tạm): idle 8h, absolute 30 ngày. Bắt buộc IDLE <= ABSOLUTE.
SESSION_IDLE_TTL=28800
SESSION_ABSOLUTE_TTL=2592000
# Cookie `idp_session` có cờ Secure. Dev qua http://localhost có thể đặt false;
# false bị TỪ CHỐI khi NODE_ENV=production (app không khởi động).
SESSION_COOKIE_SECURE=true

# Client secret rotation grace (giây) — spec §17 CHƯA chốt, 7 ngày là giá trị tạm (xem C2,
# runs/09-B3.1-B3.4/review-techlead.md). Credential cũ vẫn hợp lệ trong khoảng này sau khi rotate.
CLIENT_SECRET_GRACE_TTL=604800

# Key provider: local | aws-kms | vault (dev dùng local)
KEY_PROVIDER=local
KEY_LOCAL_DIR=./keys

# SMTP (dev: Mailpit)
SMTP_URL=smtp://localhost:1025

# Federation providers (điền khi bật B5.*)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Admin seed (tài khoản super_admin khởi tạo)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# Dev user seed (DEBT-076) — CHỈ dùng bởi `pnpm db:seed-dev` (dev-only, chặn NODE_ENV=production).
# KHÔNG nằm trong envSchema của app; app boot/int-test không đòi các biến này.
# DEV_SEED_EMAIL phải KHÁC ADMIN_SEED_EMAIL (user dev là non-admin, roles:[]).
# Để trống password ở đây (placeholder); đặt giá trị thật trong `be/.env` (git-ignored).
DEV_SEED_EMAIL=dev@example.com
DEV_SEED_PASSWORD=

# CSRF
CSRF_SECRET=replace-with-random-32-bytes

# Rate limit
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Client-auth failure rate limit (DEBT-029/039). Chỉ đếm lần xác thực client THẤT BẠI trên
# /token, /revoke, /introspect (client lạ / sai method / sai secret); request thành công không bị
# đếm. Hai bucket: theo IP (chặn DoS Argon2 bằng client_id xoay vòng) và theo client_id|ip (chặn
# brute-force secret của 1 client từ 1 IP). Cửa sổ dùng chung RATE_LIMIT_WINDOW.
CLIENT_AUTH_FAIL_IP_MAX=30
CLIENT_AUTH_FAIL_CLIENT_MAX=10

# Reverse proxy (DEBT-006): tin X-Forwarded-For để `req.ip` là IP client thật (dùng cho rate
# limit theo IP). MẶC ĐỊNH TẮT. Đặt đúng IP/CIDR của reverse proxy (vd. 10.0.0.0/8; danh sách
# phân tách dấu phẩy). CHỈ nhận IP/CIDR — giá trị dạng SỐ (số hop) bị TỪ CHỐI khi khởi động vì
# Fastify 5 âm thầm bỏ qua số (fail-closed) ⇒ req.ip rơi về IP socket. TUYỆT ĐỐI không đặt `true`
# (tin mọi XFF ⇒ spoof IP vượt bucket — bị từ chối khi khởi động). Thiếu/rỗng ⇒ dùng IP socket;
# sau reverse proxy mọi client sẽ chung 1 IP ⇒ bucket IP thành giới hạn toàn cục.
# TRUST_PROXY=

# Consent (B4.2): current policy/terms versions; bump to force re-consent
CONSENT_POLICY_VERSION=1
CONSENT_TERMS_VERSION=1
