# be — .env.example (plan §1.4). Placeholder only, KHÔNG commit secret thật.
# Copy sang .env: cp be/.env.example be/.env   (Windows: copy be\.env.example be\.env)

NODE_ENV=development
PORT=4000
ISSUER=http://localhost:4000

MONGO_URI=mongodb://localhost:27017/sso-idp
REDIS_URL=redis://localhost:6379

# Token / session TTL (giây hoặc dạng thời lượng, chốt ở B1.2)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=28800

# Key provider: local | aws-kms | vault (dev dùng local)
KEY_PROVIDER=local
KEY_LOCAL_DIR=./keys

# SMTP (dev: Mailpit)
SMTP_URL=smtp://localhost:1025

# Federation providers (điền khi bật B5.*)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Admin seed (tài khoản super_admin khởi tạo)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# CSRF
CSRF_SECRET=replace-with-random-32-bytes

# Rate limit
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
