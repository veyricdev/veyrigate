{
  "name": "@sso-idp/be",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm build:css && nest build",
    "build:css": "tailwindcss -i src/styles.css -o src/public/styles.css --minify",
    "start": "node dist/main.js",
    "start:e2e": "ts-node test/e2e/e2e-main.ts",
    "seed:e2e-admin": "ts-node test/e2e/seed-e2e-admin.ts",
    "start:dev": "nest start --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.int.config.js --runInBand",
    "test:vault": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.vault.config.js --runInBand",
    "test:sentinel": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.sentinel.config.js --runInBand",
    "db:sync-indexes": "node --env-file-if-exists=.env dist/database/mongo/sync-indexes.js",
    "db:seed-dev": "node --env-file-if-exists=.env dist/database/seed-dev.js",
    "db:seed": "node --env-file-if-exists=.env dist/database/seed.js",
    "db:admin-recover": "node --env-file-if-exists=.env dist/database/admin-recover.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.10",
    "@fastify/view": "11.1.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "@prometheus-io/client": "0.16.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "eta": "4.4.1",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "5.10.0",
    "mongoose": "9.11.4",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.1.7",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.0.5",
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.2.0",
    "@tailwindcss/cli": "4.1.14",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "30.0.5",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.14",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.20.0",
    "yaml": "2.9.1"
  }
}
