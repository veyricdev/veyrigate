{
  "name": "@sso-idp/be",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm build:css && nest build",
    "build:css": "tailwindcss -i src/styles.css -o src/public/styles.css --minify",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testRegex \"\\.int-spec\\.ts$\"",
    "db:sync-indexes": "node --env-file-if-exists=.env dist/database/mongo/sync-indexes.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "8.2.0",
    "@fastify/view": "11.1.1",
    "@nestjs/common": "12.1.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-fastify": "12.1.1",
    "@node-rs/argon2": "2.2.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "eta": "4.4.1",
    "ioredis": "6.0.0",
    "jose": "5.10.0",
    "mongoose": "9.10.2",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.12",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@jest/globals": "30.0.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.1",
    "@tailwindcss/cli": "4.1.14",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "30.0.5",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.14",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  }
}
