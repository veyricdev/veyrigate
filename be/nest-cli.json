{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "views/**/*",
      "public/**/*",
      "modules/authentication/password-policy/*.txt",
      "modules/authentication/password-policy/*.NOTICE.md"
    ]
  }
}
